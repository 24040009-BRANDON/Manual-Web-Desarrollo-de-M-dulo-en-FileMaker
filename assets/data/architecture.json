      "values": [
        "Sin definir",
        "Facebook",
        "Instagram",
        "Ambas"
      ],
      "usedIn": "Publicaciones::Plataforma_Destino",
      "note": "Destino de la publicación. Sin definir es el valor inicial (no Facebook). Ambas genera dos registros de Log, uno por plataforma."
