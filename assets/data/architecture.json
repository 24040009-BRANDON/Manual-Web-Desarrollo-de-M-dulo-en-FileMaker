  "relations": [
    {
      "id": "log",
      "title": "Publicaciones → Publicaciones_Log",
      "from": "Publicaciones_Log",
      "match": "Publicaciones::ID_Publicacion = Publicaciones_Log::ID_Publicacion",
      "cardinality": "1 : N",
      "create": "On",
      "delete": "Off",
      "sort": "Off",
      "note": "El borrado es lógico (soft delete). Delete related = Off para que el historial NUNCA se borre en cascada y se preserve la auditoría."
    },
    {
      "id": "media",
      "title": "Publicaciones → Publicacion_Multimedia",
      "from": "Publicacion_Multimedia",
      "match": "Publicaciones::ID_Publicacion = Publicacion_Multimedia::ID_Publicacion",
      "cardinality": "1 : N",
      "create": "On",
      "delete": "Off",
      "sort": "por Orden (asc)",
      "note": "Allow creation = On: el portal crea las imágenes. Sort por Orden para el carrusel. Delete related = Off: las imágenes no se borran en cascada."
    }
