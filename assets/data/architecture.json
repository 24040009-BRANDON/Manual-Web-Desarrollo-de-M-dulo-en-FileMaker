  "calcFields": [
    {
      "name": "c_Total_Publicaciones",
      "table": "Publicaciones",
      "type": "Number (calc, no almacenado)",
      "formula": "ExecuteSQL ( \"SELECT COUNT(*) FROM Publicaciones\" ; \"\" ; \"\" )",
      "desc": "Total de publicaciones registradas. Alimenta el contador \"Total\" del dashboard."
    },
    {
      "name": "c_Total_Programadas",
      "table": "Publicaciones",
      "type": "Number (calc, no almacenado)",
      "formula": "ExecuteSQL ( \"SELECT COUNT(*) FROM Publicaciones WHERE Estado = ?\" ; \"\" ; \"\" ; \"Programado\" )",
      "desc": "Publicaciones en estado Programado. Contador \"Programadas\"."
    },
    {
      "name": "c_Total_Publicadas",
      "table": "Publicaciones",
      "type": "Number (calc, no almacenado)",
      "formula": "ExecuteSQL ( \"SELECT COUNT(*) FROM Publicaciones WHERE Estado = ?\" ; \"\" ; \"\" ; \"Publicado\" )",
      "desc": "Publicaciones en estado Publicado. Contador \"Publicadas\"."
    },
    {
      "name": "c_Total_Error",
      "table": "Publicaciones",
      "type": "Number (calc, no almacenado)",
      "formula": "ExecuteSQL ( \"SELECT COUNT(*) FROM Publicaciones WHERE Estado = ?\" ; \"\" ; \"\" ; \"Error\" )",
      "desc": "Publicaciones en estado Error. Contador \"Con error\"."
    },
    {
      "name": "c_Total_Borradores",
      "table": "Publicaciones",
      "type": "Number (calc, no almacenado)",
      "formula": "ExecuteSQL ( \"SELECT COUNT(*) FROM Publicaciones WHERE Estado = ?\" ; \"\" ; \"\" ; \"Borrador\" )",
      "desc": "Publicaciones en estado Borrador. Contador \"Borradores\"."
    }
  ],
  "calcNote": "Los cinco contadores del dashboard usan ExecuteSQL en lugar de relaciones de resumen. Ventaja: una sola consulta SQL por contador, sin necesidad de table occurrences adicionales ni campos de enlace. Son campos no almacenados (se recalculan al mostrarse).",
